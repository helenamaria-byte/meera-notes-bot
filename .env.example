# Copy this file to .env for local scripts, and add the same values in
# Vercel → Project → Settings → Environment Variables.

# From @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# Any random string (letters, digits, _ and - only, up to 256 chars).
# Telegram sends it with every webhook call so the bot can reject fake requests.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram chat IDs allowed to use the bot (Meera's chat).
# Leave empty at first, send /start to the bot, and it will reply with the ID.
ALLOWED_CHAT_IDS=

# From Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use. Change if Google has released a newer one.
GEMINI_MODEL=gemini-2.5-flash

# Only needed for `npm run set-webhook`: your deployed Vercel URL, no trailing slash.
PUBLIC_URL=https://your-project.vercel.app
